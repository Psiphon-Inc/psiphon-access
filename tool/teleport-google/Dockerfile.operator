# syntax=docker/dockerfile:1
#
# Operator image for this fork. Same runtime base as the Auth image:
# gcr.io/distroless/cc-debian12, binary at /teleport-operator.
#
# Compiles in clean, digest-pinned Debian so the binary is not Nix-linked.

ARG GO_IMAGE=docker.io/library/golang@sha256:0d327c83532d3cdeeeebab56ce85962bf09cb89545355b10207c7771b0c3713f
ARG BASE_IMAGE=gcr.io/distroless/cc-debian12@sha256:6dc8478fd8e790ae427aeff51e588573dec83b13adb7e5d10505a717927009b5

FROM ${GO_IMAGE} AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

ARG VERSION=19.0.0-psiphon.1
ARG GITREF
RUN test -n "${GITREF}" || { echo "GITREF build argument is required" >&2; exit 1; }

RUN go -C build.assets/tooling run ./cmd/apiversion "${VERSION}" > api/version.go

ENV CGO_ENABLED=1
ENV GOFLAGS=-buildvcs=false
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -tags "kustomize_disable_go_plugin_support" \
      -ldflags "-w -s -X github.com/gravitational/teleport.Gitref=${GITREF}" \
      -o /out/teleport-operator ./integrations/operator

FROM ${BASE_IMAGE}
ARG VERSION=19.0.0-psiphon.1
ARG GITREF

LABEL org.opencontainers.image.title="Psiphon Access Operator" \
      org.opencontainers.image.description="Psiphon Access Operator" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GITREF}" \
      org.opencontainers.image.vendor="Psiphon Inc." \
      org.opencontainers.image.licenses="AGPL-3.0"

COPY THIRD_PARTY_NOTICES_OPERATOR /usr/local/share/licenses/teleport/THIRD_PARTY_NOTICES
COPY LICENSE /usr/local/share/licenses/teleport/LICENSE
COPY --from=builder /out/teleport-operator /teleport-operator
ENTRYPOINT ["/teleport-operator"]
